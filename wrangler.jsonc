{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soulkeep",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "observability": { "enabled": true },

  // 单源部署：SPA 产物与 /api 挂在同一个 Worker 上，同域，没有跨域与版本错配。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulkeep",
      "database_id": "6e692d22-b414-4ba1-9b4a-1398584e6dd7",
      "migrations_dir": "migrations"
    }
  ],

  // 创始人用 Auth Mini 登录。audience 是资源清单：Soulkeep 这把令牌还要拿去调 Cybion，
  // 所以本站、Cybion、Linkit 都列进来，令牌命中任何一个都认。
  "vars": {
    "AUTH_ISSUER": "https://auth.ntnl.io",
    "AUTH_AUDIENCE": "soulkeep.ntnl.io,cybion.ntnl.io,linkit.ntnl.io",
    "APP_ORIGIN": "https://soulkeep.ntnl.io"
  },

  "routes": [{ "pattern": "soulkeep.ntnl.io", "custom_domain": true }]
}
